#!/usr/bin/env python3
import json,subprocess
monitors=json.loads(subprocess.check_output(['hyprctl','-j','monitors']))
m=next((m for m in monitors if m['name'].startswith(('DSI-', 'eDP-'))), monitors[0])
t=(m.get('transform',0)+1)%4
# JSON quoting is also valid for the monitor-name Lua string.
code='hl.monitor({output=%s,mode="preferred",position="auto",scale=1.6,transform=%d})' % (json.dumps(m['name']),t)
subprocess.run(['hyprctl','eval',code],check=True)
