#!/usr/bin/env python3
"""Keep the bar, Squeekboard and physical keyboards on the same layout."""
import ast, fcntl, json, os, subprocess, sys
from pathlib import Path
layouts = ['ua', 'ru', 'us']
labels = {'ua': 'UA', 'ru': 'RU', 'us': 'US'}
os.environ.setdefault('DBUS_SESSION_BUS_ADDRESS', 'unix:path=/run/user/%d/bus' % os.getuid())
def call(args):
    return subprocess.check_output(args, text=True).strip()
with open(Path(os.environ.get('XDG_RUNTIME_DIR', '/run/user/%d' % os.getuid())) / 'nabu-layout.lock', 'w') as lock:
    fcntl.flock(lock, fcntl.LOCK_EX)
    sources = ast.literal_eval(call(['gsettings', 'get', 'org.gnome.desktop.input-sources', 'sources']))
    current = sources[0][1] if sources and sources[0][1] in layouts else 'ua'
    action = sys.argv[1] if len(sys.argv) > 1 else 'status'
    if action != 'status':
        selected = layouts[(layouts.index(current)+1) % len(layouts)] if action == 'next' else action
        if selected not in layouts:
            raise SystemExit('Expected status, next, ua, ru or us')
        ordered = [selected] + [x for x in layouts if x != selected]
        subprocess.run(['gsettings', 'set', 'org.gnome.desktop.input-sources', 'sources', repr([('xkb', x) for x in ordered])], check=True)
        for keyboard in json.loads(call(['hyprctl', '-j', 'devices']))['keyboards']:
            # Input-method keymaps belong to the OSK itself.
            if not keyboard['name'].startswith('hl-virtual-keyboard-'):
                subprocess.run(['hyprctl', 'switchxkblayout', keyboard['name'], str(layouts.index(selected))], check=True, stdout=subprocess.DEVNULL)
        current = selected
    print(labels[current])
