#!/usr/bin/env python3
import os, subprocess
os.environ.setdefault('DBUS_SESSION_BUS_ADDRESS', 'unix:path=/run/user/%d/bus' % os.getuid())
base = ['busctl', '--user']
obj = ['sm.puri.OSK0', '/sm/puri/OSK0', 'sm.puri.OSK0']
visible = subprocess.check_output(base + ['get-property'] + obj + ['Visible'], text=True).strip() == 'b true'
subprocess.run(base + ['call'] + obj + ['SetVisible', 'b', 'false' if visible else 'true'], check=True)
